{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "moduleDetection": "force",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/fx.ts"]
}
